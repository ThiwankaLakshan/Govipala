PORT=3000
NODE_ENV=development

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/govipala

# Firebase Admin SDK Credentials
# (Can be provided as file path or individual env vars)
FIREBASE_PROJECT_ID=govipala-pilot
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dev / Mock Auth Mode (Allows testing without live Firebase connection)
DEV_AUTH_ENABLED=true

# SMS Gateway (Dialog/Mobitel/Twilio)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=GOVIPALA
